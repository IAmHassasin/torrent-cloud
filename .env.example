# Copy to .env or run `npm run gen-env` to generate random secrets.
# Never commit the real .env file.

# Bearer token required by the API and the `tc` CLI (min 24 chars).
TC_API_TOKEN=change-me-to-a-long-random-string

# Shared secret between api and aria2 JSON-RPC.
ARIA2_RPC_SECRET=change-me-to-a-long-random-string

# Storage provider: s3 | local
STORAGE_PROVIDER=s3

# S3-compatible storage. Locally this is the bundled SeaweedFS container.
# For AWS S3 / Cloudflare R2 / Backblaze B2 set the endpoint, region and keys of that service.
S3_ENDPOINT=http://storage:8333
# Endpoint used inside download links (must be reachable by the person downloading).
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=torrent-cloud
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true

# Link lifetime in seconds (max 604800 = 7 days for S3 presigned URLs).
LINK_TTL_SEC=86400

# `local` provider: base URL of this API as seen by downloaders, and HMAC secret for links.
PUBLIC_BASE_URL=http://localhost:8080
LOCAL_LINK_SECRET=change-me-to-a-long-random-string

# Minutes to keep seeding after a download completes (0 = stop immediately).
SEED_TIME_MIN=0
# Optional comma-separated extra trackers for aria2.
ARIA2_BT_TRACKERS=
# Keep downloaded files on the worker after upload.
KEEP_LOCAL=false
